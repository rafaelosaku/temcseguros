<?php

// CONFIGURACOES E DEFINICOES DO SITE ##############
// Home
$serverScheme = (!empty($_SERVER['HTTPS']) && $_SERVER['HTTPS'] !== 'off') ? 'https' : 'http';
$serverHost = (!empty($_SERVER['HTTP_HOST']) ? $_SERVER['HTTP_HOST'] : 'localhost');
$scriptDir = str_replace('\\', '/', dirname($_SERVER['SCRIPT_NAME'] ?? ''));
$scriptDir = rtrim($scriptDir, '/');
define('HOME', $serverScheme . '://' . $serverHost . ($scriptDir ? $scriptDir : ''));

// Banco de dados
define('HOST', '');
define('USER', '');
define('PASS', '');
define('DBSA', '');

// DEFINE SERVIDOR DE E-MAIL #######################
define('MAILUSER', 'example@mail.com');
define('USERNAME', 'Nome de usuario');
define('MAILPASS', 'password');
define('MAILPORT', '587');
define('MAILHOST', 'host de e-mail');

// AUTO LOAD DE CLASSES  ############################
spl_autoload_register(function ($Class) {
    $cDir = ['Conn', 'Helpers', 'Models', 'Library'];

    foreach ($cDir as $dirName):
        $classFile = __DIR__ . "/{$dirName}/{$Class}.class.php";

        if (is_file($classFile)):
            include_once $classFile;
            return;
        endif;
    endforeach;

    trigger_error("Nao foi possivel incluir {$Class}.class.php", E_USER_ERROR);
});

// TIMEZONE DEFAULT
date_default_timezone_set('America/Sao_Paulo');
$script_tz = date_default_timezone_get();

// TRATAMENTO DE ERROS   ############################
// CSS constantes :: Mensagens de Erro ##############
define('WS_ACCEPT', 'accept');
define('WS_INFOR', 'infor');
define('WS_ALERT', 'alert');
define('WS_ERROR', 'error');

// WSErro :: Exibe erros lancados :: Front
function WSErro($ErrMsg, $ErrNo, $ErrDie = null) {
    $CssClass = ($ErrNo == E_USER_NOTICE ? WS_INFOR : ($ErrNo == E_USER_WARNING ? WS_ALERT : ($ErrNo == E_USER_ERROR ? WS_ERROR : $ErrNo)));
    echo "<p class=\"trigger {$CssClass}\">{$ErrMsg}<span class=\"ajax_close\"></span></p>";

    if ($ErrDie):
        die;
    endif;
}

// PHPErro :: personaliza o gatilho do PHP
function PHPErro($ErrNo, $ErrMsg, $ErrFile, $ErrLine) {
    $CssClass = ($ErrNo == E_USER_NOTICE ? WS_INFOR : ($ErrNo == E_USER_WARNING ? WS_ALERT : ($ErrNo == E_USER_ERROR ? WS_ERROR : $ErrNo)));
    echo "<p class=\"trigger {$CssClass}\">";
    echo "<b>Erro na linha: {$ErrLine} ::</b> {$ErrMsg}<br>";
    echo "<small>{$ErrFile}</small>";
    echo "<span class=\"ajax_close\"></span></p>";

    if ($ErrNo == E_USER_ERROR):
        die;
    endif;
}

set_error_handler('PHPErro');

// CONFIGURACOES DE URL AMIGAVEL ####################
$getUrl = filter_input(INPUT_GET, 'url', FILTER_DEFAULT);
$getUrl = (is_string($getUrl) ? strip_tags(trim($getUrl)) : '');
$setUrl = (empty($getUrl) ? 'index' : $getUrl);
$url = explode('/', $setUrl);

